{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "kubed-runner:spec",
  "enabledPlugins": {
    "kubed-runner@talent-show": true
  },
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit"
    ]
  }
}
