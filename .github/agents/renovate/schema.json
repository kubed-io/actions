{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "changes made",
        "question",
        "superseded"
      ],
      "description": "approve: every bump is plain and you changed nothing; your reply opens with ✅ **Approved**. changes made: you made supporting changes and nothing is open for Dr K. question: Dr K must decide something. superseded: only for a turn a Renovate push stopped, your edits undone."
    },
    "bumps": {
      "type": "array",
      "description": "One per version Renovate moved.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "jump": {
            "type": "string",
            "enum": [
              "patch",
              "minor",
              "major",
              "other"
            ],
            "description": "other: a digest, or a scheme that isn't semver."
          },
          "notes": {
            "type": "string",
            "description": "What the release notes said that matters here."
          }
        },
        "required": [
          "name",
          "from",
          "to",
          "jump",
          "notes"
        ]
      }
    },
    "changes": {
      "type": "array",
      "description": "One per file the follow-up commit changes. Empty for approve.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "why"
        ]
      }
    },
    "question": {
      "type": "string",
      "description": "The question for Dr K. Required when the verdict is question."
    }
  },
  "required": [
    "verdict",
    "bumps",
    "changes"
  ],
  "if": {
    "properties": {
      "verdict": {
        "const": "question"
      }
    }
  },
  "then": {
    "required": [
      "question"
    ]
  }
}
