{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "kubed-runner:code",
  "enabledPlugins": {
    "kubed-runner@talent-show": true
  },
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "Agent"
    ]
  }
}
