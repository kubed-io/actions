{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
  "globalExtends": [
    "config:recommended"
  ],
  "onboarding": false,
  "requireConfig": "optional",
  "dependencyDashboardApproval": true,
  "dependencyDashboardLabels": [
    "dependency-dashboard"
  ],
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null
  },
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "abandonmentThreshold": "1 year",
  "prHourlyLimit": 0,
  "ignorePaths": [
    "**/node_modules/**",
    "**/charts/**",
    "**/stuff/**",
    "**/out.yaml"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "description": "kustomize HelmChartInflationGenerator files: top-level name, repo, version",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)[^/]*(inflate|generator|helm)[^/]*\\.ya?ml$/"
      ],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "(^|\\n)kind: HelmChartInflationGenerator",
        "(^|\\n)name: (?<depName>\\S+)",
        "(^|\\n)repo: (?<registryUrl>\\S+)",
        "(^|\\n)version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "{{#if (containsString registryUrl 'oci://')}}docker{{else}}helm{{/if}}",
      "packageNameTemplate": "{{#if (containsString registryUrl 'oci://')}}{{{replace 'oci://' '' registryUrl}}}/{{{depName}}}{{else}}{{{depName}}}{{/if}}",
      "registryUrlTemplate": "{{#if (containsString registryUrl 'oci://')}}https://{{lookup (split registryUrl '/') 2}}{{else}}{{{registryUrl}}}{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "apiVersion lines are not versions to bump",
      "matchDatasources": [
        "kubernetes-api"
      ],
      "enabled": false
    },
    {
      "description": "Kubernetes pins: how to ship one",
      "matchManagers": [
        "kubernetes",
        "kustomize",
        "custom.regex"
      ],
      "prBodyNotes": [
        "Before `kubectl up`: `kubectl build` before and after this change must differ only on version lines."
      ]
    }
  ]
}
